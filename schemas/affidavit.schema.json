{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarthi.in/contracts/affidavit.schema.json",
  "title": "Affidavit",
  "description": "Transmission-of-shares affidavit payload (official SEBI format inputs).",
  "type": "object",
  "required": ["deceasedName", "applicantName", "relationship"],
  "properties": {
    "deceasedName": { "type": "string" },
    "applicantName": { "type": "string" },
    "relationship": { "type": "string" },
    "gender": { "type": ["string", "null"] },
    "fatherName": { "type": ["string", "null"] },
    "applicantAge": { "type": ["string", "null"] },
    "applicantAddress": { "type": ["string", "null"] },
    "companyName": { "type": ["string", "null"] },
    "folioOrDpid": { "type": ["string", "null"] },
    "certificateNos": { "type": ["string", "null"] },
    "distinctiveNos": { "type": ["string", "null"] },
    "faceValue": { "type": ["string", "null"] },
    "numberOfShares": { "type": ["string", "null"] },
    "dateOfDeath": { "type": ["string", "null"] },
    "placeOfDeath": { "type": ["string", "null"] },
    "familyTree": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "relationship"],
        "properties": {
          "name": { "type": "string" },
          "relationship": { "type": "string" },
          "age": { "type": ["string", "null"] },
          "share": { "type": ["number", "null"] }
        }
      }
    },
    "noObjectionFrom": { "type": "array", "items": { "type": "string" } }
  }
}
