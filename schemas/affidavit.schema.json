{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarthi.in/contracts/affidavit.schema.json",
  "title": "Affidavit",
  "description": "Legal affidavit/NOC payload generated for share transmission.",
  "type": "object",
  "required": ["deceasedName", "applicantName", "relationship", "familyTree"],
  "properties": {
    "deceasedName": { "type": "string" },
    "applicantName": { "type": "string" },
    "relationship": { "type": "string" },
    "folioOrDpid": { "type": "string" },
    "familyTree": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "relationship"],
        "properties": {
          "name": { "type": "string" },
          "relationship": { "type": "string" },
          "share": { "type": ["number", "null"] }
        }
      }
    },
    "noObjectionFrom": { "type": "array", "items": { "type": "string" } }
  }
}
