{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarthi.in/contracts/aaFetchResponse.schema.json",
  "title": "AaFetchResponse",
  "description": "Account Aggregator fetch result, shaped like a Setu/Finvu FIP response. Holding is inlined so this schema validates standalone.",
  "type": "object",
  "required": ["consentId", "fips"],
  "properties": {
    "consentId": { "type": "string" },
    "fips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fipId", "type", "data"],
        "properties": {
          "fipId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["DEPOSIT", "INVESTMENTS", "INSURANCE", "PPF"]
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "provider", "providerCode", "label"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["bank", "demat", "mutual_fund", "insurance", "ppf", "fd"]
                },
                "provider": { "type": "string" },
                "providerCode": { "type": "string" },
                "label": { "type": "string" },
                "maskedNumber": { "type": ["string", "null"] },
                "value": { "type": ["number", "null"] },
                "identifier": { "type": ["string", "null"] },
                "detail": { "type": ["string", "null"] },
                "fixUrl": { "type": ["string", "null"] },
                "nominee": {
                  "type": ["object", "null"],
                  "required": ["name", "relationship", "verified"],
                  "properties": {
                    "name": { "type": "string" },
                    "relationship": { "type": "string" },
                    "verified": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
